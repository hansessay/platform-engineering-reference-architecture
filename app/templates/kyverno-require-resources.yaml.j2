apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: require-container-resources
  labels:
    managed-by: platform-engineering-reference-architecture
spec:
  validationFailureAction: Enforce
  background: true
  rules:
    - name: require-requests-and-limits
      match:
        any:
          - resources:
              kinds:
                - Pod
              namespaces:
                - {{ environment }}-{{ owner }}
      validate:
        message: Every container must define CPU and memory requests and limits.
        pattern:
          spec:
            containers:
              - resources:
                  requests:
                    cpu: "?*"
                    memory: "?*"
                  limits:
                    cpu: "?*"
                    memory: "?*"