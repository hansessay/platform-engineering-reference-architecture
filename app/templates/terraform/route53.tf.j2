resource "aws_route53_zone" "platform" {
  name = "{{ domain_name }}"

  tags = {
    Name        = "{{ environment }}-platform-hosted-zone"
    Environment = "{{ environment }}"
    Owner       = "{{ owner }}"
    ManagedBy   = "platform-engineering-reference-architecture"
  }
}

data "aws_caller_identity" "route53_current" {}

###############################################################################
# Route 53 DNSSEC KMS key
###############################################################################

data "aws_iam_policy_document" "route53_dnssec_kms" {
  # checkov:skip=CKV_AWS_109:Route 53 DNSSEC KMS key policy requires account-root administrative permissions
  # checkov:skip=CKV_AWS_111:Route 53 DNSSEC requires constrained KMS signing and grant permissions
  # checkov:skip=CKV_AWS_356:KMS key policies use Resource wildcard because the policy is attached directly to the key

  statement {
    sid    = "EnableRootAccountPermissions"
    effect = "Allow"

    principals {
      type = "AWS"

      identifiers = [
        "arn:aws:iam::${data.aws_caller_identity.route53_current.account_id}:root"
      ]
    }

    actions = [
      "kms:*"
    ]

    resources = [
      "*"
    ]
  }

  statement {
    sid    = "AllowRoute53DNSSECSigning"
    effect = "Allow"

    principals {
      type = "Service"

      identifiers = [
        "dnssec-route53.amazonaws.com"
      ]
    }

    actions = [
      "kms:DescribeKey",
      "kms:GetPublicKey",
      "kms:Sign"
    ]

    resources = [
      "*"
    ]
  }

  statement {
    sid    = "AllowRoute53DNSSECCreateGrant"
    effect = "Allow"

    principals {
      type = "Service"

      identifiers = [
        "dnssec-route53.amazonaws.com"
      ]
    }

    actions = [
      "kms:CreateGrant"
    ]

    resources = [
      "*"
    ]

    condition {
      test     = "Bool"
      variable = "kms:GrantIsForAWSResource"

      values = [
        "true"
      ]
    }
  }
}

resource "aws_kms_key" "route53_dnssec" {
  provider = aws.us_east_1

  description              = "Route 53 DNSSEC signing key for {{ environment }}"
  deletion_window_in_days  = 30
  key_usage                = "SIGN_VERIFY"
  customer_master_key_spec = "ECC_NIST_P256"
  enable_key_rotation      = false
  policy                   = data.aws_iam_policy_document.route53_dnssec_kms.json

  tags = {
    Name        = "{{ environment }}-platform-route53-dnssec"
    Environment = "{{ environment }}"
    Owner       = "{{ owner }}"
    ManagedBy   = "platform-engineering-reference-architecture"
  }
}

resource "aws_kms_alias" "route53_dnssec" {
  provider = aws.us_east_1

  name          = "alias/{{ environment }}-platform-route53-dnssec"
  target_key_id = aws_kms_key.route53_dnssec.key_id
}

resource "aws_route53_key_signing_key" "platform" {
  hosted_zone_id             = aws_route53_zone.platform.id
  key_management_service_arn = aws_kms_key.route53_dnssec.arn
  name                       = "{{ environment }}-platform-ksk"
  status                     = "ACTIVE"
}

resource "aws_route53_hosted_zone_dnssec" "platform" {
  hosted_zone_id = aws_route53_zone.platform.id

  depends_on = [
    aws_route53_key_signing_key.platform
  ]
}

###############################################################################
# Route 53 query-log encryption KMS key
###############################################################################

data "aws_iam_policy_document" "route53_logs_kms" {
  # checkov:skip=CKV_AWS_109:KMS key policy requires account-root administrative permissions
  # checkov:skip=CKV_AWS_111:CloudWatch Logs requires constrained KMS permissions for encryption
  # checkov:skip=CKV_AWS_356:KMS key policies use Resource wildcard because the policy is attached directly to the key

  statement {
    sid    = "EnableRootAccountPermissions"
    effect = "Allow"

    principals {
      type = "AWS"

      identifiers = [
        "arn:aws:iam::${data.aws_caller_identity.route53_current.account_id}:root"
      ]
    }

    actions = [
      "kms:*"
    ]

    resources = [
      "*"
    ]
  }

  statement {
    sid    = "AllowCloudWatchLogsEncryption"
    effect = "Allow"

    principals {
      type = "Service"

      identifiers = [
        "logs.us-east-1.amazonaws.com"
      ]
    }

    actions = [
      "kms:Encrypt*",
      "kms:Decrypt*",
      "kms:ReEncrypt*",
      "kms:GenerateDataKey*",
      "kms:Describe*"
    ]

    resources = [
      "*"
    ]

    condition {
      test     = "ArnEquals"
      variable = "kms:EncryptionContext:aws:logs:arn"

      values = [
        "arn:aws:logs:us-east-1:${data.aws_caller_identity.route53_current.account_id}:log-group:/aws/route53/{{ environment }}-platform"
      ]
    }
  }
}

resource "aws_kms_key" "route53_query_logs" {
  provider = aws.us_east_1

  description             = "KMS key for Route 53 query logs in {{ environment }}"
  deletion_window_in_days = 30
  enable_key_rotation     = true
  policy                  = data.aws_iam_policy_document.route53_logs_kms.json

  tags = {
    Name        = "{{ environment }}-platform-route53-query-logs-kms"
    Environment = "{{ environment }}"
    Owner       = "{{ owner }}"
    ManagedBy   = "platform-engineering-reference-architecture"
  }
}

resource "aws_kms_alias" "route53_query_logs" {
  provider = aws.us_east_1

  name          = "alias/{{ environment }}-platform-route53-query-logs"
  target_key_id = aws_kms_key.route53_query_logs.key_id
}

###############################################################################
# Route 53 query logging
###############################################################################

resource "aws_cloudwatch_log_group" "route53_query_logs" {
  provider = aws.us_east_1

  name              = "/aws/route53/{{ environment }}-platform"
  retention_in_days = 365
  kms_key_id        = aws_kms_key.route53_query_logs.arn

  tags = {
    Name        = "{{ environment }}-platform-route53-query-logs"
    Environment = "{{ environment }}"
    Owner       = "{{ owner }}"
    ManagedBy   = "platform-engineering-reference-architecture"
  }
}

data "aws_iam_policy_document" "route53_query_logs" {
  statement {
    sid    = "AllowRoute53QueryLogging"
    effect = "Allow"

    principals {
      type = "Service"

      identifiers = [
        "route53.amazonaws.com"
      ]
    }

    actions = [
      "logs:CreateLogStream",
      "logs:PutLogEvents"
    ]

    resources = [
      "${aws_cloudwatch_log_group.route53_query_logs.arn}:*"
    ]
  }
}

resource "aws_cloudwatch_log_resource_policy" "route53_query_logs" {
  provider = aws.us_east_1

  policy_name     = "{{ environment }}-platform-route53-query-logs"
  policy_document = data.aws_iam_policy_document.route53_query_logs.json
}

resource "aws_route53_query_log" "platform" {
  zone_id                  = aws_route53_zone.platform.zone_id
  cloudwatch_log_group_arn = aws_cloudwatch_log_group.route53_query_logs.arn

  depends_on = [
    aws_cloudwatch_log_resource_policy.route53_query_logs
  ]
}