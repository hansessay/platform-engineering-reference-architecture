# ============================================
# Python
# ============================================
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Python packaging
build/
dist/
*.egg-info/

# ============================================
# Environment variables / Secrets
# ============================================
.env
.env.*
*.pem
*.key

# ============================================
# Terraform
# ============================================
# Terraform working directories
**/.terraform/

# Terraform dependency lock file
**/.terraform.lock.hcl

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
**/terraform.tfvars

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ============================================
# Generated Platform Output
# ============================================
# Keep generated manifests and Terraform in Git
# Ignore only temporary Terraform artifacts
generated/**/.terraform/
generated/**/.terraform.lock.hcl
generated/**/*.tfstate
generated/**/*.tfstate.*
generated/**/*.tfplan
generated/**/terraform.tfvars

# ============================================
# VS Code
# ============================================
.vscode/

# ============================================
